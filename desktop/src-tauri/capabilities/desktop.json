{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Allow the bundled room UI to request one-use runtime tickets and choose a local workspace.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-runtime-bootstrap-status",
    "allow-runtime-bootstrap-initialize",
    "allow-runtime-ticket",
    "allow-runtime-operator-ticket",
    "allow-runtime-preferences-read-ticket",
    "allow-runtime-preferences-write-ticket",
    "allow-runtime-human-invite-create-ticket",
    "allow-runtime-human-invite-revoke-ticket",
    "allow-runtime-settings-directory-read-ticket",
    "allow-runtime-central-registration-ticket",
    "allow-cache-selected-room-directory",
    "allow-choose-local-workspace",
    "allow-host-product-surface"
  ]
}
