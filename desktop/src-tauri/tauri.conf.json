{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentsAssemble",
  "version": "0.1.0",
  "identifier": "app.agentsassemble.rust",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run build",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentsAssemble",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agentsassemble-server"]
  }
}
