{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentsAssemble",
  "version": "0.1.1",
  "identifier": "app.agentsassemble.rust",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentsassemble"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RjNENEJEQTNGOEFCMjMKUldRanEvaWp2ZFR6Wi9UKzRVdmYzWUlZZWt6S1ZLR0lGYUE2YmJZNDdScWE2Zzd5aW1IOTI1U20K",
      "endpoints": [
        "https://github.com/kwd421/agentsassemble-rust/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm --prefix ../provider-runtime ci --omit=optional --ignore-scripts && npm --prefix ../frontend run build",
    "beforeBuildCommand": "npm --prefix ../provider-runtime ci --omit=optional --ignore-scripts && npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentsAssemble",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://agentsassemble-identity-directory.seinel.workers.dev; img-src 'self' data: blob: http://127.0.0.1:*",
      "capabilities": [
        "desktop"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/agentsassemble-server",
      "binaries/agentsassemble-runtime-supervisor"
    ],
    "resources": {
      "../../frontend/dist/": "frontend/",
      "../../provider-runtime/claude-owner-requests.mjs": "provider-runtime/claude-owner-requests.mjs",
      "../../provider-runtime/claude-native-delivery.mjs": "provider-runtime/claude-native-delivery.mjs",
      "../../provider-runtime/claude-agent-sdk-bridge.mjs": "provider-runtime/claude-agent-sdk-bridge.mjs",
      "../../provider-runtime/node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs": "provider-runtime/node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
